# Copiar como .env en la raíz del repositorio. Valores solo para desarrollo local.
# Los puertos son los de tu máquina: si alguno está ocupado, cambialo acá.

# Base de datos (PostgreSQL)
DB_NAME=conocimiento_critico
DB_USER=tfi
DB_PASSWORD=tfi_local
DB_HOST=localhost
# Puerto de la base en tu máquina. 5433 evita chocar con un PostgreSQL local.
DB_PORT=5433
# Ejecuta las migraciones pendientes al iniciar el backend
DB_MIGRATIONS_RUN=true

# Almacenamiento de archivos (RustFS, compatible con S3)
# Puertos de RustFS en tu máquina (API S3 y consola web)
S3_PORT=9100
S3_CONSOLE_PORT=9101
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=activos-conocimiento
# Tamaño máximo por archivo de un activo de conocimiento, en MB (1 a 100)
ACTIVOS_TAMANIO_MAX_MB=20

# Backend
PORT=3000
# Secreto que firma la cookie de sesión (32 caracteres o más)
SESION_SECRETO=cambiame-por-un-secreto-largo-de-32-o-mas-caracteres
# Primer administrador: se crea al arrancar solo si no hay usuarios
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambiame-clave-larga

# Frontend
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
